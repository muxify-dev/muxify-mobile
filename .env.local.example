# Copy to .env.local and fill in. Used by the ticket 04/05 transport spike only.
#
# For an OrbStack VM: OrbStack runs a plain-TCP SSH gateway on the Mac's
# loopback, and the iOS Simulator shares the host network stack, so 127.0.0.1
# reaches it. Find the port with:  ssh -G orb | grep -E '^(hostname|port) '
# The VM's own IP is NOT reachable; use the gateway.
EXPO_PUBLIC_DEV_SSH_HOST=127.0.0.1
EXPO_PUBLIC_DEV_SSH_PORT=32222
EXPO_PUBLIC_DEV_SSH_USER=default
EXPO_PUBLIC_DEV_SSH_SESSION=0

# Private key, newlines escaped as \n. Must not be passphrase-protected.
#   python3 -c "import io;print(io.open('$HOME/.orbstack/ssh/id_ed25519').read().replace(chr(10),'\\\\n'),end='')"
EXPO_PUBLIC_DEV_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----\n
