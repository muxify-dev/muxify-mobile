{
  "name": "muxify",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@expo/ui": "57.0.18",
    "@osuki-dev/react-native-ssh": "0.3.0",
    "expo": "57.0.23",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.18",
    "expo-device": "57.0.2",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.3",
    "expo-image": "57.0.5",
    "expo-image-picker": "57.0.19",
    "expo-libghostty": "0.8.1",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "bash e2e/seed-dev-host.sh && bash e2e/sandbox.sh agent-device test ./e2e/tmux-attach.ad ./e2e/surface-smoke.ad ./e2e/session-picker.ad ./e2e/back-to-home.ad",
    "e2e:roundtrip": "bash e2e/ls-round-trip.sh",
    "e2e:pickers": "bash e2e/pickers.sh",
    "e2e:regressions": "bash e2e/regressions.sh",
    "e2e:header": "bash e2e/header.sh",
    "e2e:key-row": "bash e2e/key-row.sh",
    "e2e:pane-swipes": "bash e2e/pane-swipes.sh",
    "e2e:control": "jest --testPathIgnorePatterns /node_modules/ --runTestsByPath e2e/control-mode.test.ts",
    "e2e:composer": "jest --testPathIgnorePatterns /node_modules/ --runTestsByPath e2e/composer.test.ts",
    "e2e:topics": "jest --testPathIgnorePatterns /node_modules/ --runTestsByPath e2e/topics.test.ts",
    "e2e:topic-screen": "bash e2e/topic-screen.sh",
    "e2e:new-topic": "bash e2e/new-topic.sh",
    "e2e:edit-topic": "bash e2e/edit-topic.sh",
    "e2e:add-session": "bash e2e/add-session.sh",
    "e2e:reconnect": "bash e2e/reconnect-on-start.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  }
}
