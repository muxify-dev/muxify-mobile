context platform=ios kind=simulator

# Surface smoke test (ticket 03).
#
# Proves the app launches, navigates to the Terminal Screen, and that the
# Surface lays out and reports a cell grid — the header's `pane-command` renders
# only once the Attach has connected on a settled grid and read the Topology,
# so its presence is the signal that the native terminal view came up.
#
# What this CANNOT assert: the Surface's contents. ghostty renders cells with
# Metal, so the terminal text is absent from the accessibility tree (the view
# exposes a bare TextView rect with no text). Verifying what is actually drawn
# needs screenshot comparison, not selectors.
#
# Run with:  bash e2e/sandbox.sh agent-device test ./e2e/surface-smoke.ad

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000

# Through the real flow now: a saved Host, its Sessions, then one of them.
press "label=\"All of Dev Host\""
wait "label=\"Edit Host\"" 15000
# Home is still under the Host Screen until the push settles, and has the
# same Session and Topic rows.
wait 1500
wait "label=\"Session 0\"" 15000
press "label=\"Session 0\""
# The header's program line renders once the Topology has an active Pane,
# which the Attach reads only after it is connected on a settled grid — so
# its presence says the Surface laid out, the Connection is attached and the
# Topology is in.
wait "id=\"pane-command\"" 20000

close
