context platform=ios kind=simulator

# Reconnect on start: a cold start goes back to the Last Place.
#
# Attaching to e2e-reconnect, a Session the script makes, writes the Last
# Place. A relaunch then shows "Trying to reconnect" with Go to Host, and ends on
# that Session, Connected, with its Host Screen under it.
#
# Run with:  bash e2e/reconnect-on-start.sh

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
press "label=\"Host Dev Host\""
wait "label=\"Edit Host\"" 15000
wait 1500
wait "label=\"Session e2e-reconnect\"" 15000
press "label=\"Session e2e-reconnect\""
wait "id=\"pane-command\"" 20000
is "text" "id=\"attached-session\"" "e2e-reconnect"

open "dev.muxify.app" --relaunch
wait "id=\"reconnect-screen\"" 15000
is "visible" "label=\"Go to Host\""
wait "id=\"pane-command\"" 20000
is "text" "id=\"attached-session\"" "e2e-reconnect"
is "absent" "id=\"reconnect-screen\""

# Back returns to the Host Screen.
back
wait "label=\"Edit Host\"" 8000
is "visible" "label=\"Session e2e-reconnect\""

close
