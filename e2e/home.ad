context platform=ios kind=simulator

# Home, with the one Host the sandbox has (see e2e/sandbox.sh): its section
# has its name and a green Connection dot, its Sessions are rows under it, and
# a tap on a row attaches. All opens that Host's Host Screen. Run it with:
#
#   bash e2e/sandbox.sh agent-device test ./e2e/home.ad
#
# Several Hosts, an unreachable one and the order are e2e/hosts.sh's.

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
wait "label=\"Connected\"" 15000
is "visible" "label=\"Session 0\""

press "label=\"All of Dev Host\""
wait "label=\"New Session\"" 8000
press "role=button label=\"Muxify\""
wait "label=\"Settings\"" 8000

press "label=\"Session 0\""
wait "id=\"connection-status\"" 8000
wait 8000
is "text" "id=\"connection-status\"" "Connected"

close
