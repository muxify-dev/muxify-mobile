context platform=ios kind=simulator

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
press "label=\"Host Dev Host\""
wait "label=\"Host Options\"" 15000
wait 1500

wait "label=\"Topic e2e Add Session\"" 15000
press "label=\"Topic e2e Add Session\""
wait "label=\"Search folders\"" 15000
fill "role=text-field" "/tmp/muxify e2e missing"
press "label=\"Use /tmp/muxify e2e missing\""
press "label=\"Create and open\""
wait "text" "no directory" 15000
is "visible" "role=text-field"
fill "role=text-field" "/tmp/muxify e2e add"
press "label=\"Use /tmp/muxify e2e add\""
press "label=\"Create and open\""
wait "id=\"pane-command\"" 20000
is "text" "id=\"attached-session\"" "muxifye2eadd/e2e-add-session"
press "label=\"Options\""
wait "label=\"Topic\" role=button" 8000
press "label=\"Topic\" role=button"
wait "label=\"Add a Session…\" role=button" 8000
press "label=\"Add a Session…\" role=button"
wait "label=\"Search folders\"" 8000
press "label=\"Cancel\""
wait "id=\"pane-command\"" 8000

close
