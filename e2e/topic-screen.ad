context platform=ios kind=simulator

# The Topic Screen, against the Topics that e2e/topic-screen.sh makes on the
# dev Host. Run that script, not this file: it makes the Topics in a sandbox
# and turns the Topics list on.
#
# A tap on a live Topic shows its Note, its Tag and its Session. A tap on the
# Session attaches, and Home from there is the Host Screen, not the Topic
# Screen (D6). An Empty Topic says it has no live Sessions, and why.
#
# The Host Screen also has each Session row and the "No live Sessions" line of
# an Empty Topic's card. So each wait after a tap on a Topic is for text that
# only the Topic Screen has, and that shows only when its read is back.

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000
press "label=\"Dev Host\""

wait "label=\"Topic e2e Topic Screen live\"" 15000
press "label=\"Topic e2e Topic Screen live\""
wait "label=\"Note Seeded by e2e\"" 15000
is "visible" "label=\"Session muxify-e2e-topic-screen/e2e-topic-screen-live\""
is "visible" "role=text text=\"#work\""

press "label=\"Session muxify-e2e-topic-screen/e2e-topic-screen-live\""
wait "id=\"connection-status\"" 8000
wait 8000
is "text" "id=\"connection-status\"" "Connected"

# The Host Screen: its toolbar has +, which the Topic Screen has not. With
# the Topics list on, + is New Session or Topic. The role is part of the
# selector because a snapshot can also list the Dock capsule that holds Home
# under the same label, and an ambiguous press is refused.
press "role=button label=\"Home\""
wait "label=\"New Session or Topic\"" 8000
is "visible" "label=\"Topic e2e Topic Screen live\""

press "label=\"Topic e2e Topic Screen empty\""
wait "text=\"This Topic is Empty: it has no Sessions.\"" 15000
is "visible" "text=\"This Topic is Empty: it has no Sessions.\""

close
