context platform=ios kind=simulator

# tmux attach over SSH (tickets 04 and 05).
#
# Requires a reachable dev Host in .env.local with a tmux Session already
# running — see .env.local.example. Skip this suite if you have not configured
# one; it will fail at the connection banner rather than silently pass.
#
# The assertion is indirect by necessity. The Surface renders with Metal, so
# tmux's output never reaches the accessibility tree and cannot be asserted on.
# What CAN be asserted is the connection indicator, which is always present and
# carries the phase as its text. "Connected" means the Connection authenticated
# and the Shell Channel is carrying the Session; a failure reads "Failed: ..."
# and fails this assertion with the reason visible.
#
# Run with:  agent-device test ./e2e/tmux-attach.ad

open "dev.muxify.app" --relaunch
wait "text" "No Hosts yet" 15000

press "label=\"Open Surface smoke test\""
wait "text" "Terminal" 8000

# The Surface laid out and reported a grid.
is "visible" "id=\"surface-grid\""

# Give the Connection time to authenticate and attach.
wait 8000

# Connected: the Shell Channel is attached to the Session.
is "text" "id=\"connection-status\"" "Connected"

close
