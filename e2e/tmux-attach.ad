context platform=ios kind=simulator

# tmux attach over SSH (tickets 04 and 05).
#
# Requires a dev Host in .env.local, and the sandbox, whose tmux server has
# Session 0 — see e2e/sandbox.sh. Without them it fails at the connection
# banner rather than silently pass.
#
# The assertion is indirect by necessity. The Surface renders with Metal, so
# tmux's output never reaches the accessibility tree and cannot be asserted on.
# What CAN be asserted is the connection indicator, which is always present and
# carries the phase as its text. "Connected" means the Connection authenticated
# and the Shell Channel is carrying the Session; a failure reads "Failed: ..."
# and fails this assertion with the reason visible.
#
# Run with:  bash e2e/sandbox.sh agent-device test ./e2e/tmux-attach.ad

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000

# Through the real flow now: a saved Host, its Sessions, then one of them.
press "label=\"All of Dev Host\""
wait "label=\"Edit Host\"" 15000
# Home is still under the Host Screen until the push settles, and has the
# same Session and Topic rows.
wait 1500
wait "label=\"Session 0\"" 15000
press "label=\"Session 0\""
# The Terminal Screen has no navigation header to wait for — it draws the
# Surface to the top of the display, and the Dock's Home button replaces the
# back button — so the status indicator is what says the screen is up.
wait "id=\"connection-status\"" 8000

# The Surface laid out and reported a grid.
wait "id=\"surface-grid\"" 8000

# Give the Connection time to authenticate and attach.
wait 8000

# Connected: the Shell Channel is attached to the Session.
is "text" "id=\"connection-status\"" "Connected"

# The Dock's keyboard button toggles the system keyboard in both directions.
# A letter key is the signal: the library's Accessory Bar used to serve, but it
# is hidden now (see ADR 0003), and the system keyboard only exists while the
# Surface holds first responder.
press "label=\"Keyboard\""
wait "label=\"q\"" 5000
is "visible" "label=\"q\""

press "label=\"Keyboard\""
wait 2500

# The glass Dock rendered and works: pressing Home leaves the Terminal Screen,
# which also tears the Connection down. Asserting the navigation proves both
# that the Dock is there and that its button is reachable — a bare visibility
# check on the SwiftUI button does not match through the hosting boundary.
press "role=button label=\"Home\""
wait "text" "Dev Host" 8000

close
