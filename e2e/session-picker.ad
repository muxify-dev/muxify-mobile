context platform=ios kind=simulator

# Session picker (ticket 08).
#
# Covers everything automation can reach: the header's title, the Title Sheet,
# Switch… in it, and the Sessions picker it opens.
#
# What this deliberately stops short of: selecting a row. Nothing inside a
# presented sheet responds to agent-device — not a row at its own measured
# coordinates, not iOS's own drag indicator, not swipe-to-dismiss — while the
# same Buttons in the Key Row press fine. Verified by hand on the simulator: the
# sheet works perfectly for a finger, so this is the harness not reaching a
# presented sheet, the same class of limitation as the on-screen return key.
#
# Switching is therefore verified below the UI instead: `TmuxClient` has unit
# coverage, and `session-preparer.test.ts` covers what has to happen to a
# Session on arrival and on the way out.
#
# It ends by closing rather than dismissing, because the sheet it opens cannot
# be dismissed from here. Other suites are unaffected: each one relaunches.
#
# Run with:  bash e2e/sandbox.sh agent-device test ./e2e/session-picker.ad

open "dev.muxify.app" --relaunch
wait "text" "Dev Host" 15000

# Through the real flow now: a saved Host, its Sessions, then one of them.
press "label=\"All of Dev Host\""
wait "label=\"Edit Host\"" 15000
# Home is still under the Host Screen until the push settles, and has the
# same Session and Topic rows.
wait 1500
wait "label=\"Session 0\"" 15000
press "label=\"Session 0\""
# The header's program line renders once the Topology has an active Pane,
# which the Attach reads only after it is connected on a settled grid — so
# its presence says the Surface laid out, the Connection is attached and the
# Topology is in.
wait "id=\"pane-command\"" 20000

# The title opens the Title Sheet, waited for by its own close button.
press "id=\"header-title\""
wait "label=\"Close Windows\"" 15000
is "exists" "label=\"Switch…\""

# Switch… closes it and opens the Sessions picker in its place.
press "label=\"Switch…\""
wait "label=\"Close Sessions\"" 15000

# The sheet is up with its own chrome. The Sessions themselves are asserted in
# e2e/pickers.sh, which can set up the Host's Topology first — this Host's
# Session is named "0", and agent-device will not match a numeric selector.
#
# The close button is named for what it closes. It used to answer to a bare
# "Close" as well, because an xmark image carries that label of its own; the
# button is now the system's close role, which is one node with one name — the
# same one e2e/pickers.sh presses.
#
# `exists` rather than `visible`: SwiftUI content inside a presented sheet
# reports itself unhittable to agent-device even where a finger can press it.
is "exists" "label=\"Close Sessions\""

close
