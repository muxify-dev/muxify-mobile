   BOOL isRTL = _controller.view.semanticContentAttribute == UISemanticContentAttributeForceRightToLeft;
   if (isRTL) {
     x = _controller.view.frame.size.width - x;
@@ -1136,9 +1147,33 @@ - (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer shouldReceive
 
 - (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer shouldReceiveTouch:(UITouch *)touch;
 {
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+  if (@available(iOS 26, *)) {
+    if (gestureRecognizer == _controller.interactiveContentPopGestureRecognizer &&
+        gestureRecognizer.numberOfTouches == 0) {
+      _contentPopLanding = [touch locationInView:gestureRecognizer.view];
+    }
+  }
+#endif // check for iOS >= 26
   return [self gestureRecognizer:gestureRecognizer shouldReceivePressOrTouchEvent:touch];
 }
 
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+// A screen that limits where its content pop begins gives that area to the pop: a touch that
+// landed there pops even over a scroll view that scrolls sideways, as the edge pop does.
+- (BOOL)isContentPopLimitedAndLandedInside:(UIGestureRecognizer *)gestureRecognizer API_AVAILABLE(ios(26.0))
+{
+  if (gestureRecognizer != _controller.interactiveContentPopGestureRecognizer) {
+    return NO;
+  }
+  RNSScreenView *topScreen = _reactSubviews.lastObject;
+  NSDictionary *distance = topScreen.gestureResponseDistance;
+  BOOL limited = [distance[@"start"] floatValue] != -1 || [distance[@"end"] floatValue] != -1 ||
+      [distance[@"top"] floatValue] != -1 || [distance[@"bottom"] floatValue] != -1;
+  return limited && [self isInGestureResponseDistance:gestureRecognizer topScreen:topScreen];
+}
+#endif // check for iOS >= 26
+
 - (BOOL)gestureRecognizer:(UIGestureRecognizer *)gestureRecognizer
     shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)otherGestureRecognizer
 {
