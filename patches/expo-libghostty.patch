+    guard let position = position as? TerminalSelectionPosition else { return nil }
+    switch direction {
+    case .left: return move(position, by: -offset)
+    case .right: return move(position, by: offset)
+    case .up, .down:
+      let line = position.line + (direction == .down ? offset : -offset)
