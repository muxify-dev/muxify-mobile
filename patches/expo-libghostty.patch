@@ -36,6 +36,27 @@ public class ExpoLibghosttyModule: Module {
       AsyncFunction("finish") { (view: ExpoLibghosttyView, exitCode: UInt32) in
         view.finish(exitCode: exitCode)
       }.runOnQueue(.main)
+
+      // Raise the system keyboard by making the terminal first responder.
+      AsyncFunction("focus") { (view: ExpoLibghosttyView) -> Bool in
+        view.focusTerminal()
+      }.runOnQueue(.main)
+
+      // Dismiss the system keyboard by resigning first responder.
+      AsyncFunction("blur") { (view: ExpoLibghosttyView) -> Bool in
+        view.blurTerminal()
+      }.runOnQueue(.main)
+
+      // Whether the terminal currently holds first responder.
+      AsyncFunction("isFocused") { (view: ExpoLibghosttyView) -> Bool in
+        view.isTerminalFocused
+      }.runOnQueue(.main)
+
+      // The accessory bar of ctrl/esc/tab/arrows above the keyboard. Defaults
+      // to visible, which is the library's own behaviour.
+      Prop("accessoryBar") { (view: ExpoLibghosttyView, visible: Bool?) in
+        view.setAccessoryBar(visible: visible ?? true)
+      }
     }
   }
 }
diff --git a/ios/ExpoLibghosttyView.swift b/ios/ExpoLibghosttyView.swift
index 12925b541f7d4ebb98b5a9976486a561c69d6fe2..f4d5507702af8e9cf494302d4b5ba95d38710ba3 100644
--- a/ios/ExpoLibghosttyView.swift
+++ b/ios/ExpoLibghosttyView.swift
@@ -83,4 +83,33 @@ class ExpoLibghosttyView: ExpoView {
   func finish(exitCode: UInt32) {
     session?.finish(exitCode: exitCode, runtimeMilliseconds: 0)
   }
+
+  /// Make the terminal first responder, raising the system keyboard and its
+  /// accessory bar. Also tells ghostty's core it has focus.
+  @discardableResult
+  func focusTerminal() -> Bool {
+    terminalView.becomeFirstResponder()
+  }
+
+  /// Resign first responder, dismissing the keyboard.
+  @discardableResult
+  func blurTerminal() -> Bool {
+    terminalView.resignFirstResponder()
+  }
+
+  /// Whether the terminal currently holds first responder.
+  var isTerminalFocused: Bool {
+    terminalView.isFirstResponder
+  }
+
+  /// Show or hide the accessory bar the library puts above the keyboard.
+  ///
+  /// `inputAccessoryView` is already nil when there are no items, so emptying
+  /// the list is all this takes; the property's `didSet` reloads the input
+  /// views, so it applies while the keyboard is up.
+  func setAccessoryBar(visible: Bool) {
+    #if !targetEnvironment(macCatalyst)
+      terminalView.inputAccessoryItems = visible ? TerminalInputAccessoryItem.defaultItems : []
+    #endif
+  }
 }
