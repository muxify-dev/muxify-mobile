+    // reports nothing at all.
+    guard surfaceAttached, cols > 0, rows > 0, cellWidthPixels > 0, cellHeightPixels > 0 else {
+      return
+    }
+    let scale = terminalView.contentScaleFactor
+    let divisor = scale > 0 ? Double(scale) : 1
+    let grid = Report(
+      cols: cols,
+      rows: rows,
+      cellWidth: Double(cellWidthPixels) / divisor,
+      cellHeight: Double(cellHeightPixels) / divisor
+    )
+    if let reported, reported.generation == surfaceGeneration, reported.grid == grid { return }
+    reported = (surfaceGeneration, grid)
+    selectionLayer.cell = CGSize(width: grid.cellWidth, height: grid.cellHeight)
+
+    // The surface is built and has a shape, so what waited for one can land.
+    // Before the report rather than after: a caller that answers the report
+    // by repainting must find its repaint on top of what was held, not under.
+    flushPendingOutput()
+
+    onResize([
+      "cols": grid.cols,
+      "rows": grid.rows,
+      "cellWidth": grid.cellWidth,
+      "cellHeight": grid.cellHeight,
+    ])
+  }
+
+  // MARK: - Output
+
+  /// Whether the surface under the view has a grid to lay bytes out on.
+  ///
+  /// A surface that exists but has not reported is one ghostty is still
+  /// sizing, and bytes parsed into it at the default grid would be reflowed
+  /// to the real one — so they wait for the report, exactly as bytes with no
+  /// surface at all do.
+  private var canDraw: Bool {
+    surfaceAttached && reported?.generation == surfaceGeneration
   }
 
   /// Feed PTY output (terminal.output on the wire) into the grid.
   func write(_ data: Data) {
+    guard canDraw else {
+      hold(data)
+      return
+    }
     session?.receive(data)
   }
 
   /// Feed PTY output as UTF-8 text, for string-based wires.
   func write(_ text: String) {
-    session?.receive(text)
+    guard let data = text.data(using: .utf8) else { return }
+    write(data)
+  }
+
+  private func hold(_ data: Data) {
+    if pendingOutputBytes + data.count > Self.pendingOutputLimit {
+      pendingOutput.removeAll()
+      pendingOutputBytes = 0
+    }
+    pendingOutput.append(data)
+    pendingOutputBytes += data.count
+  }
+
+  private func flushPendingOutput() {
+    guard !pendingOutput.isEmpty, let session else { return }
+    let held = pendingOutput
+    pendingOutput.removeAll()
+    pendingOutputBytes = 0
+    for data in held { session.receive(data) }
   }
 
   /// Mark the underlying PTY as exited (terminal.exit on the wire).
   func finish(exitCode: UInt32) {
     session?.finish(exitCode: exitCode, runtimeMilliseconds: 0)
   }
+
+  // MARK: - Keyboard
+
+  /// Make the terminal first responder, raising the system keyboard and its
+  /// accessory bar. Also tells ghostty's core it has focus.
+  @discardableResult
+  func focusTerminal() -> Bool {
+    terminalView.becomeFirstResponder()
+  }
+
+  /// Resign first responder, dismissing the keyboard.
+  @discardableResult
+  func blurTerminal() -> Bool {
+    terminalView.resignFirstResponder()
+  }
+
+  /// Whether the terminal currently holds first responder.
+  var isTerminalFocused: Bool {
+    terminalView.isFirstResponder
+  }
+
+  /// Show or hide the accessory bar the library puts above the keyboard.
+  ///
+  /// `inputAccessoryView` is already nil when there are no items, so emptying
+  /// the list is all this takes; the property's `didSet` reloads the input
+  /// views, so it applies while the keyboard is up.
+  func setAccessoryBar(visible: Bool) {
+    #if !targetEnvironment(macCatalyst)
+      terminalView.inputAccessoryItems = visible ? TerminalInputAccessoryItem.defaultItems : []
+    #endif
+  }
+
+  /// Show or hide the iPad shortcut bar, the undo, redo and Paste row iOS puts
+  /// over the keyboard.
+  ///
+  /// The bar is the first responder's `inputAssistantItem`, and iOS leaves it
+  /// out when it has no button groups. The terminal and the selection layer
+  /// both become first responder, so both are emptied, or the bar comes back
+  /// during a selection. Showing it again puts back the groups iOS gave.
+  func setShortcutBar(visible: Bool) {
+    #if !targetEnvironment(macCatalyst)
+      for responder in [terminalView as UIResponder, selectionLayer] {
+        let item = responder.inputAssistantItem
+        let key = ObjectIdentifier(responder)
+        if visible {
+          guard let groups = hiddenShortcutGroups.removeValue(forKey: key) else { continue }
+          item.leadingBarButtonGroups = groups.leading
+          item.trailingBarButtonGroups = groups.trailing
+        } else if hiddenShortcutGroups[key] == nil {
+          hiddenShortcutGroups[key] = (item.leadingBarButtonGroups, item.trailingBarButtonGroups)
+          item.leadingBarButtonGroups = []
+          item.trailingBarButtonGroups = []
+        }
+        if responder.isFirstResponder { responder.reloadInputViews() }
+      }
+    #endif
+  }
 }
