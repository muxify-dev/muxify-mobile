new file mode 100644
index 0000000000000000000000000000000000000000..fbe0d5aa5d50c80c19da6cc588783542e1ffaea5
--- /dev/null
+++ b/ios/TerminalSelectionLayer.swift
@@ -0,0 +1,788 @@
+import UIKit
+import UIKit.UIGestureRecognizerSubclass
+
+// Muxify patch: the whole file.
+//
+// The Selection Layer: iOS text selection over a terminal that keeps no text.
+//
+// The terminal view draws glyphs with Metal and its own UITextInput is the
+// keyboard's composition buffer, so neither can be selected in. This view is
+// a second, read-only UITextInput document laid over the terminal, cell for
+// cell. It draws nothing itself. UIKit draws the highlight, the handles, the
+// loupe and the edit menu from what this view says about its text.
+//
+// The text is not here until it is asked for. A long press asks the host for
+// the rows under the view, and the host answers with `show`. From then until
+// `end` the host keeps the picture underneath still and sends the rows again
+// each time it moves the picture.
+
+/// One row of the terminal, as the host read it.
+struct TerminalSelectionRow {
+  let text: NSString
+  /// The cell each UTF-16 unit starts at, and the row's width last. Nil when
+  /// each unit is one cell.
+  let cells: [Int]?
+  /// Whether the row runs on into the next one, so a copy joins the two.
+  let wraps: Bool
+
+  static let empty = TerminalSelectionRow(text: "", cells: nil, wraps: false)
+
+  var length: Int { text.length }
+
+  func cell(at unit: Int) -> Int {
+    guard let cells, !cells.isEmpty else { return unit }
+    return cells[max(0, min(unit, cells.count - 1))]
+  }
+
+  /// The first unit of the character drawn in this cell, or nil past the
+  /// row's end.
+  func unit(containing cell: Int) -> Int? {
+    guard let cells else { return cell >= 0 && cell < length ? cell : nil }
+    guard let width = cells.last, cell >= 0, cell < width,
+      let last = cells.prefix(length).lastIndex(where: { $0 <= cell })
+    else { return nil }
+    return cells.firstIndex(of: cells[last])
+  }
+
+  /// The first unit that starts at this cell or after it.
+  func unit(at cell: Int) -> Int {
+    guard let cells else { return max(0, min(cell, length)) }
+    return min(cells.firstIndex { $0 >= cell } ?? length, length)
+  }
+}
+
+/// A place in the document: a line of the host's, and a UTF-16 unit in it.
+/// Lines and not one running offset, so a place stays good when the host
+/// adds rows above it.
+final class TerminalSelectionPosition: UITextPosition {
+  let line: Int
+  let unit: Int
+
+  init(line: Int, unit: Int) {
+    self.line = line
+    self.unit = unit
+  }
+
+  static func < (a: TerminalSelectionPosition, b: TerminalSelectionPosition) -> Bool {
+    a.line != b.line ? a.line < b.line : a.unit < b.unit
+  }
+}
+
+final class TerminalSelectionRange: UITextRange {
+  let from: TerminalSelectionPosition
+  let to: TerminalSelectionPosition
+
+  init(_ a: TerminalSelectionPosition, _ b: TerminalSelectionPosition) {
+    from = b < a ? b : a
+    to = b < a ? a : b
+  }
+
+  override var start: UITextPosition { from }
+  override var end: UITextPosition { to }
+  override var isEmpty: Bool { from.line == to.line && from.unit == to.unit }
+}
+
+private final class TerminalSelectionRect: UITextSelectionRect {
+  private let frame: CGRect
+  private let first: Bool
+  private let last: Bool
+
+  init(_ frame: CGRect, first: Bool, last: Bool) {
+    self.frame = frame
+    self.first = first
+    self.last = last
+  }
+
+  override var rect: CGRect { frame }
+  override var writingDirection: NSWritingDirection { .leftToRight }
+  override var containsStart: Bool { first }
+  override var containsEnd: Bool { last }
+  override var isVertical: Bool { false }
+}
+
+/// Follows the finger and never recognizes. UIKit does not say when a handle
+/// drag ends, and the scroll at the edges must stop when the finger lifts.
+private final class TouchTracker: UIGestureRecognizer {
+  private(set) var isDown = false
+  private(set) var location = CGPoint.zero
+  /// Counts the touches, so one can be told from the next.
+  private(set) var touch = 0
+  var onBegin: (() -> Void)?
+  var onMove: (() -> Void)?
+
+  override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+    isDown = true
+    touch += 1
+    location = touches.first?.location(in: view) ?? .zero
+    onBegin?()
+  }
+
+  override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent) {
+    location = touches.first?.location(in: view) ?? location
+    onMove?()
+  }
+
+  override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+    isDown = false
+    state = .failed
+  }
+
+  override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
+    isDown = false
+    state = .failed
+  }
+
+  override func canPrevent(_ other: UIGestureRecognizer) -> Bool { false }
+  override func canBePrevented(by other: UIGestureRecognizer) -> Bool { false }
+}
+
+final class TerminalSelectionLayer: UIView, UITextInput, UIEditMenuInteractionDelegate {
+  /// A long press landed and there are no rows to select in.
+  var onPress: ((CGPoint) -> Void)?
+  /// A selection opened or closed.
+  var onOpenChange: ((Bool) -> Void)?
+  /// The rows are let go: the host may move the picture again.
+  var onEnd: (() -> Void)?
+  /// Paste was chosen. The host reads the pasteboard, inside this call.
+  var onPaste: (() -> Void)?
+  /// A handle is held at the top (-1) or bottom (1) edge: one more line, please.
+  var onEdge: ((Int) -> Void)?
+
+  /// One cell of the terminal, in points.
+  var cell = CGSize(width: 8, height: 16)
+  /// The view that has the keyboard when there is no selection.
+  weak var keyboardOwner: UIView?
+
+  private var rows: [Int: TerminalSelectionRow] = [:]
+  private var firstLine = 0
+  private var lastLine = -1
+  /// The line drawn in the view's first row.
+  private var topLine = 0
+  private var hasRows: Bool { lastLine >= firstLine }
+
+  private var selection: TerminalSelectionRange?
+  private var isOpen: Bool { selection.map { !$0.isEmpty } ?? false }
+  /// Whether the keyboard goes back to its owner when the selection ends.
+  private var returnsKeyboard = false
+
+  private let textInteraction = UITextInteraction(for: .nonEditable)
+  private lazy var menu = UIEditMenuInteraction(delegate: self)
+  private let press = UILongPressGestureRecognizer()
+  private let tracker = TouchTracker()
+
+  /// The touch that is dragging a handle, or nil. UIKit does not say that a
+  /// handle is held, nor where: it sets the selection once, when the finger
+  /// lifts. So a touch that lands on an end of the selection is taken to be
+  /// on that end's handle.
+  private var handleTouch: Int?
+  /// The end of the selection that the held handle is not on.
+  private var fixedEnd: TerminalSelectionPosition?
+  /// The selection the edge scroll made. UIKit stops following a handle at
+  /// the edge of the view, so the range it sets when the finger lifts is the
+  /// one from before the scroll, and this one takes its place.
+  private var edgeRange: TerminalSelectionRange?
+  private var edgeTimer: Timer?
+
+  override init(frame: CGRect) {
+    super.init(frame: frame)
+    backgroundColor = .clear
+    clipsToBounds = true
+
+    textInteraction.textInput = self
+    addInteraction(textInteraction)
+    addInteraction(menu)
+
+    press.minimumPressDuration = 0.5
+    press.addTarget(self, action: #selector(pressed(_:)))
+    addGestureRecognizer(press)
+
+    tracker.cancelsTouchesInView = false
+    tracker.delaysTouchesEnded = false
+    // UIKit says nothing while a handle is dragged, so the finger is
+    // followed here for the scroll at the edges.
+    tracker.onBegin = { [weak self] in self?.noteHandleTouch() }
+    tracker.onMove = { [weak self] in
+      self?.followEdgeDrag()
+      self?.startEdgeScrollIfNeeded()
+    }
+    addGestureRecognizer(tracker)
+
+    syncSystemGestures()
+  }
+
+  @available(*, unavailable)
+  required init?(coder: NSCoder) {
+    fatalError("init(coder:) has not been implemented")
+  }
+
+  // MARK: - What the host says
+
+  /// Takes rows from the host and the line now in the first row. `pressed` is
+  /// the long press these rows answer.
+  func show(rows fresh: [(line: Int, row: TerminalSelectionRow)], top: Int, pressed: CGPoint?) {
+    for (line, row) in fresh {
+      rows[line] = row
+      if !hasRows {
+        firstLine = line
+        lastLine = line
+      }
+      firstLine = min(firstLine, line)
+      lastLine = max(lastLine, line)
+    }
+    topLine = top
+
+    if let pressed {
+      begin(at: pressed)
+    } else if isOpen {
+      followEdgeDrag()
+      refreshDisplay()
+    }
+  }
+
+  /// Closes the selection and lets the rows go.
+  func end(keepingMenu: Bool = false) {
+    // With nothing held there is nothing to close. The host is still told,
+    // because it asked. The Paste menu over a place with no text is up in
+    // this state, and it stays.
+    guard hasRows || selection != nil else {
+      onEnd?()
+      return
+    }
+    stopEdgeScroll()
+    let wasOpen = isOpen
+    if selection != nil {
+      inputDelegate?.selectionWillChange(self)
+      selection = nil
+      inputDelegate?.selectionDidChange(self)
+    }
+    rows.removeAll()
+    firstLine = 0
+    lastLine = -1
+    syncSystemGestures()
+    if wasOpen { onOpenChange?(false) }
+    if !keepingMenu {
+      menu.dismissMenu()
+      returnKeyboard()
+    }
+    onEnd?()
+  }
+
+  /// Takes first responder, which the edit menu's actions go to, and
+  /// remembers whether the keyboard's owner had it.
+  private func takeKeyboard() {
+    guard !isFirstResponder else { return }
+    returnsKeyboard = keyboardOwner?.isFirstResponder ?? false
+    becomeFirstResponder()
+  }
+
+  private func returnKeyboard() {
+    guard isFirstResponder else { return }
+    if returnsKeyboard, let keyboardOwner {
+      keyboardOwner.becomeFirstResponder()
+      return
+    }
+    resignFirstResponder()
+    // UIKit passes first responder on to the next view that can take it,
+    // which is the keyboard's owner. It did not have the keyboard before,
+    // so it does not get it now.
+    if keyboardOwner?.isFirstResponder == true { keyboardOwner?.resignFirstResponder() }
+  }
+
+  // MARK: - Starting
+
+  @objc private func pressed(_ recognizer: UILongPressGestureRecognizer) {
+    guard recognizer.state == .began else { return }
+    let point = recognizer.location(in: self)
+    if hasRows {
+      begin(at: point)
+    } else {
+      onPress?(point)
+    }
+  }
+
+  /// Selects the word at a point, or offers Paste where there is no text.
+  private func begin(at point: CGPoint) {
+    guard let hit = character(at: point) else {
+      // Nothing to select here. With no selection open the rows are not
+      // needed either: Paste alone needs none. The keyboard's owner can
+      // take Paste itself, so the keyboard stays up if it is up.
+      let open = isOpen
+      if keyboardOwner?.isFirstResponder != true { takeKeyboard() }
+      menu.presentEditMenu(with: UIEditMenuConfiguration(identifier: nil, sourcePoint: point))
+      if !open { end(keepingMenu: true) }
+      return
+    }
+    let range = word(at: hit)
+
+    handleTouch = nil
+    takeKeyboard()
+    inputDelegate?.selectionWillChange(self)
+    selectedTextRange = range
+    inputDelegate?.selectionDidChange(self)
+    refreshDisplay()
+    menu.presentEditMenu(with: UIEditMenuConfiguration(identifier: nil, sourcePoint: point))
+  }
+
+  /// The word a character is in, as iOS divides a line into words, or the
+  /// character alone where it is in none.
+  private func word(at hit: TerminalSelectionPosition) -> TerminalSelectionRange {
+    let text = row(hit.line).text
+    var found = text.rangeOfComposedCharacterSequence(at: hit.unit)
+    text.enumerateSubstrings(
+      in: NSRange(location: 0, length: text.length), options: [.byWords, .substringNotRequired]
+    ) { _, range, _, stop in
+      guard NSLocationInRange(hit.unit, range) else { return }
+      found = range
+      stop.pointee = true
+    }
+    return TerminalSelectionRange(
+      TerminalSelectionPosition(line: hit.line, unit: found.location),
+      TerminalSelectionPosition(line: hit.line, unit: NSMaxRange(found))
+    )
+  }
+
+  /// The character under a point, or nil over a space or past a row's end.
+  private func character(at point: CGPoint) -> TerminalSelectionPosition? {
+    let line = topLine + Int(floor(point.y / cell.height))
+    guard let row = rows[line], let unit = row.unit(containing: Int(floor(point.x / cell.width)))
+    else { return nil }
+    if let scalar = UnicodeScalar(row.text.character(at: unit)),
+      CharacterSet.whitespaces.contains(scalar)
+    {
+      return nil
+    }
+    return TerminalSelectionPosition(line: line, unit: unit)
+  }
+
+  /// UIKit draws a selection it made itself. One set from here it draws only
+  /// when told that the selection display is in use.
+  private func refreshDisplay() {
+    guard #available(iOS 17.0, *) else { return }
+    for display in interactions.compactMap({ $0 as? UITextSelectionDisplayInteraction }) {
+      display.isActivated = isOpen
+      display.setNeedsSelectionUpdate()
+    }
+  }
+
+  /// The system's taps are live only while a selection is open: a tap then
+  /// closes it. With none open the same tap would take first responder and
+  /// put the keyboard down. The system's own long press stays off, because
+  /// the press goes to the host for the rows first.
+  private func syncSystemGestures() {
+    for recognizer in gestureRecognizers ?? [] {
+      guard let name = recognizer.name, name.hasPrefix("UITextInteractionName") else { continue }
+      if name == "UITextInteractionNameRangeAdjustment" { continue }
+      recognizer.isEnabled = isOpen && name != "UITextInteractionNameInteractiveRefinement"
+    }
+  }
+
+  /// UIKit asks the view a touch landed in whether a recognizer may begin,
+  /// and each touch on the terminal lands in this view. The terminal decides
+  /// about its own recognizers there: its pan takes its axis in that call.
+  override func gestureRecognizerShouldBegin(_ recognizer: UIGestureRecognizer) -> Bool {
+    if recognizer.view === self { return true }
+    return superview?.gestureRecognizerShouldBegin(recognizer) ?? true
+  }
+
+  // MARK: - The edges
+
+  /// The part of the view that is on screen, which is less than its bounds
+  /// when a parent clips it.
+  private var visibleBounds: CGRect {
+    var visible = bounds
+    var parent = superview
+    while let view = parent {
+      if view.clipsToBounds { visible = visible.intersection(convert(view.bounds, from: view)) }
+      parent = view.superview
+    }
+    return visible
+  }
+
+  private func noteHandleTouch() {
+    handleTouch = nil
+    edgeRange = nil
+    guard let selection, isOpen else { return }
+    let finger = tracker.location
+    // The knob sits outside the text, above the start and below the end.
+    let reach = max(cell.height, 24)
+    let start = caretRect(for: selection.from).insetBy(dx: -reach, dy: -reach)
+    let end = caretRect(for: selection.to).insetBy(dx: -reach, dy: -reach)
+    guard start.contains(finger) || end.contains(finger) else { return }
+    let toStart = hypot(finger.x - start.midX, finger.y - start.midY)
+    let toEnd = hypot(finger.x - end.midX, finger.y - end.midY)
+    handleTouch = tracker.touch
+    fixedEnd = toStart <= toEnd ? selection.to : selection.from
+  }
+
+  /// -1 with the finger at the top edge, 1 at the bottom edge, 0 between.
+  private var edgeUnderFinger: Int {
+    guard tracker.isDown, handleTouch == tracker.touch else { return 0 }
+    // Half a row and no more: a handle's knob hangs outside its row, and a
+    // drag along the first or the last row must not be a scroll.
+    let visible = visibleBounds
+    if tracker.location.y < visible.minY + cell.height * 0.5 { return -1 }
+    if tracker.location.y > visible.maxY - cell.height * 0.5 { return 1 }
+    return 0
+  }
+
+  private func startEdgeScrollIfNeeded() {
+    guard edgeTimer == nil, isOpen, edgeUnderFinger != 0 else { return }
+    let timer = Timer(timeInterval: 0.06, repeats: true) { [weak self] _ in
+      guard let self else { return }
+      let edge = self.edgeUnderFinger
+      guard self.isOpen, edge != 0 else {
+        // Back between the edges with the finger down, the handle is
+        // UIKit's alone again. Lifted, UIKit has still to set its range.
+        if self.tracker.isDown { self.edgeRange = nil }
+        self.stopEdgeScroll()
+        return
+      }
+      self.onEdge?(edge)
+    }
+    // Common modes: the run loop is in its tracking mode while a finger
+    // is down, and a timer in the default mode waits for the finger to lift.
+    RunLoop.main.add(timer, forMode: .common)
+    edgeTimer = timer
+  }
+
+  private func stopEdgeScroll() {
+    edgeTimer?.invalidate()
+    edgeTimer = nil
+  }
+
+  /// The finger or the picture moved while a handle is held at an edge: the
+  /// end the handle is on goes to the row now under the finger.
+  private func followEdgeDrag() {
+    guard edgeTimer != nil, let fixedEnd,
+      let moved = closestPosition(to: tracker.location) as? TerminalSelectionPosition
+    else { return }
+    let range = TerminalSelectionRange(fixedEnd, moved)
+    guard !range.isEmpty else { return }
+    inputDelegate?.selectionWillChange(self)
+    selection = range
+    inputDelegate?.selectionDidChange(self)
+    edgeRange = range
+  }
+
+  // MARK: - First responder and the edit menu
+
+  override var canBecomeFirstResponder: Bool { true }
+
+  /// Something else took the keyboard, the Composer for one. The selection
+  /// does not stay open under it.
+  override func resignFirstResponder() -> Bool {
+    let resigned = super.resignFirstResponder()
+    if resigned, isOpen {
+      DispatchQueue.main.async { [weak self] in
+        guard let self, self.isOpen, !self.isFirstResponder else { return }
+        self.end()
+      }
+    }
+    return resigned
+  }
+
+  override func canPerformAction(_ action: Selector, withSender sender: Any?) -> Bool {
+    switch action {
+    case #selector(copy(_:)): return isOpen
+    case #selector(paste(_:)): return onPaste != nil
+    case #selector(cut(_:)), #selector(delete(_:)), #selector(select(_:)), #selector(selectAll(_:)):
+      return false
+    default: return super.canPerformAction(action, withSender: sender)
+    }
+  }
+
+  override func copy(_ sender: Any?) {
+    guard let selection, !selection.isEmpty else { return }
+    UIPasteboard.general.string = text(in: selection, joiningWraps: true)
+    end()
+  }
+
+  override func paste(_ sender: Any?) {
+    onPaste?()
+    end()
+  }
+
+  /// AutoFill types a password into a text field, and this is not one.
+  private func withoutAutoFill(_ actions: [UIMenuElement]) -> UIMenu {
+    guard #available(iOS 17.0, *) else { return UIMenu(children: actions) }
+    func kept(_ elements: [UIMenuElement]) -> [UIMenuElement] {
+      elements.compactMap { element in
+        guard let menu = element as? UIMenu else { return element }
+        return menu.identifier == .autoFill ? nil : menu.replacingChildren(kept(menu.children))
+      }
+    }
+    return UIMenu(children: kept(actions))
+  }
+
+  /// The Paste menu over a place with no text has no selection to end it,
+  /// so the keyboard goes back when the menu goes.
+  func editMenuInteraction(
