+  // MARK: - The document
+
+  private func row(_ line: Int) -> TerminalSelectionRow { rows[line] ?? .empty }
+
+  /// The text of a range, each row ending its line. Copy joins the wraps: a
+  /// row that wraps runs straight into the next one, as it was typed. UIKit
+  /// gets every row end, because it counts places in this text.
+  private func text(in range: TerminalSelectionRange, joiningWraps: Bool) -> String {
+    var text = ""
+    for line in range.from.line...range.to.line {
+      let row = row(line)
+      let from = line == range.from.line ? min(range.from.unit, row.length) : 0
+      let to = line == range.to.line ? min(range.to.unit, row.length) : row.length
+      text += row.text.substring(with: NSRange(location: from, length: max(0, to - from)))
+      if line < range.to.line, !(joiningWraps && row.wraps) { text += "\n" }
+    }
+    return text
+  }
+
+  /// A place moved by a count of UTF-16 units, where each row end counts one.
+  private func move(_ position: TerminalSelectionPosition, by offset: Int) -> TerminalSelectionPosition? {
+    var line = position.line
+    var unit = position.unit + offset
+    while unit < 0 {
+      guard line > firstLine else { return nil }
+      line -= 1
+      unit += row(line).length + 1
+    }
+    while unit > row(line).length {
+      guard line < lastLine else { return nil }
+      unit -= row(line).length + 1
+      line += 1
+    }
+    return TerminalSelectionPosition(line: line, unit: unit)
+  }
+
+  private func clamped(_ line: Int) -> Int { max(firstLine, min(lastLine, line)) }
