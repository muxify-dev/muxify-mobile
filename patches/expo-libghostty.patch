+  private func top(of line: Int) -> CGFloat { CGFloat(line - topLine) * cell.height }
+
+  private func rect(line: Int, from: Int, to: Int) -> CGRect {
+    let row = row(line)
+    let left = CGFloat(row.cell(at: from)) * cell.width
+    let right = CGFloat(row.cell(at: to)) * cell.width
+    return CGRect(x: left, y: top(of: line), width: right - left, height: cell.height)
+  }
+
+  func firstRect(for range: UITextRange) -> CGRect {
+    selectionRects(for: range).first?.rect ?? .zero
+  }
+
+  func caretRect(for position: UITextPosition) -> CGRect {
+    guard let position = position as? TerminalSelectionPosition else { return .zero }
+    var caret = rect(line: position.line, from: position.unit, to: position.unit)
+    caret.size.width = 2
+    return caret
+  }
+
+  func selectionRects(for range: UITextRange) -> [UITextSelectionRect] {
+    guard let range = range as? TerminalSelectionRange else { return [] }
+    // The rows on screen, and the two ends wherever they are: a selection
+    // can run for thousands of lines, and UIKit asks for this often.
+    let shown = Int(ceil(bounds.height / max(cell.height, 1)))
+    var lines = Set([range.from.line, range.to.line])
+    let low = max(range.from.line, topLine - 1)
+    let high = min(range.to.line, topLine + shown + 1)
+    if low <= high { lines.formUnion(low...high) }
+
+    return lines.sorted().map { line in
+      let from = line == range.from.line ? range.from.unit : 0
+      let to = line == range.to.line ? range.to.unit : row(line).length
+      var frame = rect(line: line, from: from, to: to)
+      // A row the selection runs through shows as selected though it is empty.
+      if line != range.to.line { frame.size.width = max(frame.width, cell.width) }
+      return TerminalSelectionRect(frame, first: line == range.from.line, last: line == range.to.line)
+    }
+  }
+
+  func closestPosition(to point: CGPoint) -> UITextPosition? {
+    let line = clamped(topLine + Int(floor(point.y / cell.height)))
+    let unit = row(line).unit(at: Int((point.x / cell.width).rounded()))
+    return TerminalSelectionPosition(line: line, unit: unit)
+  }
+
+  func closestPosition(to point: CGPoint, within range: UITextRange) -> UITextPosition? {
+    guard let range = range as? TerminalSelectionRange,
+      let position = closestPosition(to: point) as? TerminalSelectionPosition
+    else { return nil }
+    if position < range.from { return range.from }
+    if range.to < position { return range.to }
+    return position
+  }
+
+  func characterRange(at point: CGPoint) -> UITextRange? {
+    let line = clamped(topLine + Int(floor(point.y / cell.height)))
+    let unit = min(row(line).unit(at: Int(floor(point.x / cell.width))), row(line).length)
+    let start = TerminalSelectionPosition(line: line, unit: unit)
+    guard let next = move(start, by: 1) else { return nil }
+    return TerminalSelectionRange(start, next)
+  }
